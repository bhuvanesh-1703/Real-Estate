# Server Configuration
PORT=5000
NODE_ENV=production
STRICT_DB=true

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Credentials (Required in Production)
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=

# CORS Configuration (Allowed Frontend Origins, comma-separated)
# Example: https://real-estate-gamma.vercel.app,http://localhost:5173
FRONTEND_URL=

# Data Seeding Control
# Set to 'true' ONLY if you want to insert missing demo properties/leads on boot
SEED_DEMO_DATA=false

# Make.com Automation Integration
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=

